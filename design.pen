            {
              "type": "frame",
              "id": "VoB5y",
              "name": "Usage Guidelines",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": "$radius-md",
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 10,
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "yVWza",
                  "name": "Guidelines Title",
                  "fill": "$primary",
                  "content": "04 / Usage guidelines",
                  "fontFamily": "$font-mono",
                  "fontSize": 12,
                  "fontWeight": "700",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "jrAx0",
                  "name": "Guidelines Body",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "DO\n• Use one primary action per section.\n• Keep status words explicit: Open, Closed, Revealed, Hidden.\n• Use semantic tokens, never raw colors.\n• Prefer vertical rhythm over dense admin tables.\n\nDON’T\n• Don’t imply acceptance before confirmation.\n• Don’t use color alone to communicate state.\n• Don’t hide recovery actions in overflow menus.\n• Don’t animate live updates that steal focus.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "iaPqe",
              "name": "Accessibility and Motion",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": "$radius-md",
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 10,
              "padding": 20,
              "children": [
                {
                  "type": "text",
                  "id": "B1LLJZ",
                  "name": "Access Title",
                  "fill": "$primary",
                  "content": "Accessibility + motion",
                  "fontFamily": "$font-mono",
                  "fontSize": 12,
                  "fontWeight": "700",
                  "letterSpacing": 1
                },
                {
                  "type": "text",
                  "id": "qnRqX",
                  "name": "Access Body",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "FOCUS\n2px primary ring + 2px offset; never remove focus.\n\nTOUCH\n44px minimum target; full-width submit on mobile.\n\nLIVE UPDATES\nAnnounce result changes politely; never steal focus.\n\nMOTION\n120ms controls · 180ms surfaces · 240ms sheets.\nRespect prefers-reduced-motion: reduce to instant.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font-sans",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
