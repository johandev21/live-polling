# Copy to .env in the repo root to override the default secrets used by
# `docker compose up --build`. Every value is optional: dev defaults are
# provided for a zero-config first run. Generate real secrets with:
#   openssl rand -base64 32

# Secret used by Better Auth to sign host sessions and magic links.
BETTER_AUTH_SECRET=

# Secret used to sign participant session-local identity tokens.
PARTICIPANT_TOKEN_SECRET=
