# Copy to .env and adjust for your environment.
# Requires `docker compose up -d postgres redis mailpit` in the repo root.

# --- Postgres (Docker Compose maps 5433 -> 5432). Use port 5432 for a native install.
DATABASE_URL=postgresql://polling:polling@localhost:5433/polling
DATABASE_POOL_MAX=10

# --- Redis (presence, rate limits, Socket.io cross-instance pub/sub)
REDIS_URL=redis://localhost:6379

# --- Better Auth (host magic links)
# Public base URL of the backend itself.
BETTER_AUTH_URL=http://localhost:3000
# Any 32+ character secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-secret
# Comma-separated origins allowed to call the API with credentials.
FRONTEND_ORIGINS=http://localhost:5173

# --- HTTP
PORT=3000

# --- Participant session-local identity tokens (falls back to BETTER_AUTH_SECRET)
PARTICIPANT_TOKEN_SECRET=replace-me-with-a-different-32-plus-character-secret

# --- Mail (magic links land in Mailpit: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@live-polling.local

# --- Presence (Redis TTL)
PRESENCE_TTL_SECONDS=30
PRESENCE_SWEEP_INTERVAL_MS=10000
